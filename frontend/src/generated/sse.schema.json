{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopkeeper.local/contracts/sse.schema.json",
  "title": "问数 SSE 事件",
  "description": "后端每条形如 `data: <json>\\n\\n`。契约只约束这三种事件；前端遇到未知的 type 必须忽略并留一条记录，而不是当成一次失败（后端加事件类型不该让用户看到红框）。",
  "oneOf": [
    {
      "$ref": "#/$defs/progress"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "progress": {
      "type": "object",
      "required": [
        "type",
        "step",
        "status",
        "duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "progress"
        },
        "step": {
          "type": "string",
          "description": "必须是 contracts/steps.yaml 里声明过的 step id"
        },
        "status": {
          "enum": [
            "running",
            "success",
            "error",
            "skipped"
          ]
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "success / error 时必填数字；running / skipped 时必须为 null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "success",
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "duration_ms": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "duration_ms": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "result"
        },
        "data": {
          "type": "object",
          "required": [
            "columns",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "string",
                      "number",
                      "boolean",
                      "null",
                      "date"
                    ]
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "type",
        "code",
        "class",
        "message",
        "step"
      ],
      "additionalProperties": false,
      "description": "S6 失败通道。`error` 不等于「红框」：class 决定 UI 怎么渲染（failure 红框 / empty 空态 / cancelled 取消态）。`code` 必须来自 contracts/errors.yaml。",
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "机器可判定的错误码，取值见 contracts/errors.yaml"
        },
        "class": {
          "enum": [
            "failure",
            "empty",
            "cancelled"
          ],
          "description": "失败类别：failure 真失败 / empty 合法但无数据 / cancelled 用户取消"
        },
        "message": {
          "type": "string"
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "object",
          "description": "可复制的细节：原因码、原始 SQL、校正后的 SQL、重试次数。",
          "additionalProperties": false,
          "properties": {
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "sql": {
              "type": [
                "string",
                "null"
              ]
            },
            "original_sql": {
              "type": [
                "string",
                "null"
              ]
            },
            "corrected_sql": {
              "type": [
                "string",
                "null"
              ]
            },
            "attempts": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "rows": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "request_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
